# Copy to .env and fill in. Only SECRET_KEY is required for production.

# Sessions are signed with this. Generate:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development only: enables the reloader and stack traces
FLASK_ENV=development
FLASK_DEBUG=1

# SQLite file defaults to instance/newsperz.db
# DATABASE_PATH=/absolute/path/to/newsperz.db

# News providers. "auto" = Google News RSS, plus NewsAPI when a key is present.
# Options: auto | rss | newsapi
NEWS_PROVIDER=auto
NEWS_API_KEY=
NEWS_TIMEOUT=4
NEWS_CACHE_TTL=300

# Locale for the Google News RSS feed
NEWS_LOCALE_HL=en-IN
NEWS_LOCALE_GL=IN
NEWS_LOCALE_CEID=IN:en

# Brute-force protection for /auth/login
LOGIN_MAX_ATTEMPTS=7
LOGIN_WINDOW_SECONDS=900

# Content-Security-Policy is on by default (all scripts/styles are external or nonce'd).
# SEND_CSP_HEADER=0
